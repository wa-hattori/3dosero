# fastlaneが読み込む環境変数のテンプレート。
#
# ローカル(Mac)でのデバッグ手順:
#   cp fastlane/.env.default fastlane/.env
#   fastlane/.env に実際の値を書く(このファイルは.gitignore対象、コミットしない)
#
# GitHub Actions上では、同名のRepository SecretsからCIが直接環境変数として
# 注入するため .env は使わない(.github/workflows/ios-release.yml参照)。
#
# 各値の取得手順は、Apple Developer Program登録後に別途案内する
# (.claude/skills/ios-native-packaging/SKILL.md 参照)。

# App Store Connect APIキー(release laneでのみ必要。build_localでは不要)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=
ASC_TEAM_ID=

# release laneでのバージョン更新(省略時はXcodeプロジェクトの現在値のまま)
MARKETING_VERSION=
BUILD_NUMBER=
