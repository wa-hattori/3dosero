# 正本: .claude/skills/ios-native-packaging/SKILL.md の「CI: .github/workflows/ios-release.yml」
# 「署名: App Store Connect APIキー方式」節。
#
# CI(.github/workflows/ios-release.yml)とMacでのローカルデバッグの両方から
# 同じlaneを呼ぶ。環境変数はCIではGitHub Secretsから、ローカルでは
# fastlane/.env(.env.default をコピーして作成する。gitignore対象)から
# dotenv経由で読み込まれる。

require "base64"
require "tempfile"

default_platform(:ios)

# `npx cap add ios`が生成するXcodeプロジェクトの実体は`ios-app/`直下ではなく
# `ios-app/ios/App/App.xcodeproj`にある。fastlaneはこの`fastlane/`ディレクトリの
# 親(=`ios-app/`)をカレントディレクトリとして実行されるため、`agvtool`を使う
# アクション(increment_version_number/increment_build_number)には明示的に
# `xcodeproj:`を渡す必要がある(渡さないと「カレントディレクトリに.xcodeprojが無い」
# エラーになる)。build_appも同様に明示する。
# なお本プロジェクトはCapacitor 8のSwift Package Manager構成のため
# `.xcworkspace`は存在せず、`.xcodeproj`を直接指定する。
XCODEPROJ_PATH = "ios/App/App.xcodeproj"

platform :ios do
  desc "ローカル動作確認用: 自動署名でXcodeプロジェクトがビルドできることだけを確認する" \
       "(App Store Connect資格情報は不要。ios-app/README.mdのデバッグ手順から使う想定)"
  lane :build_local do
    build_app(
      scheme: "App",
      project: XCODEPROJ_PATH,
      export_method: "development",
      output_directory: "./build",
    )
  end

  desc "App Store Connect API Keyで署名し、TestFlightにアップロードする(CI・ローカル共通のリリースフロー)"
  lane :release do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    if ENV["MARKETING_VERSION"]
      increment_version_number(xcodeproj: XCODEPROJ_PATH, version_number: ENV["MARKETING_VERSION"])
    end
    if ENV["BUILD_NUMBER"]
      increment_build_number(xcodeproj: XCODEPROJ_PATH, build_number: ENV["BUILD_NUMBER"])
    end

    # `npx cap add ios`が生成した直後のプロジェクトはCODE_SIGN_STYLE=Automaticだが
    # DEVELOPMENT_TEAMが未設定のため、CI(誰もXcodeにApple IDでサインインしていない
    # macOSランナー)では署名対象のチームが決まらずビルドが失敗する
    # (「Signing for "App" requires a development team」)。ASC_TEAM_IDを
    # DEVELOPMENT_TEAMとして明示的に書き込む。
    update_code_signing_settings(
      use_automatic_signing: true,
      path: XCODEPROJ_PATH,
      team_id: ENV.fetch("ASC_TEAM_ID"),
    )

    # プロジェクト生成時点の`CODE_SIGN_IDENTITY`が両Configurationとも
    # 旧形式の"iPhone Developer"(=Development証明書)に固定されているため、
    # archive時にも配布用ではなく開発用プロビジョニングプロファイルが要求され、
    # 「Your team has no devices from which to generate a provisioning
    # profile」で失敗する。Release configurationだけ"Apple Distribution"に
    # 上書きする(実際にCIで踏んだ不具合)。
    update_code_signing_settings(
      path: XCODEPROJ_PATH,
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
    )

    # gym(build_app)はapp_store_connect_api_keyで取得した資格情報を
    # xcodebuildのクラウド署名(-allowProvisioningUpdates)へ自動転送しない
    # (fastlane公式でも「あったら便利だが未実装」として認識されている既知の制約。
    # https://github.com/fastlane/fastlane/discussions/19973)。そのため
    # .p8の内容を一時ファイルに書き出し、-authenticationKeyPath等をxcargsで
    # 明示的に渡す。渡さないと「No Accounts: Add a new account in Accounts
    # settings.」でxcodebuildがローカルXcodeアカウントでの署名にフォールバック
    # しようとして失敗する(実際にCIで踏んだ不具合)。
    key_file = Tempfile.new(["asc_key", ".p8"])
    key_file.write(Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))
    key_file.close

    build_app(
      scheme: "App",
      project: XCODEPROJ_PATH,
      export_method: "app-store",
      export_team_id: ENV.fetch("ASC_TEAM_ID"),
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath '#{key_file.path}' " \
              "-authenticationKeyID #{key_id} " \
              "-authenticationKeyIssuerID #{issuer_id}",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
