{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-commit-message.js\"",
            "statusMessage": "Linting commit message against Angular convention..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-console-debugger.js\"",
            "statusMessage": "Checking for leftover console.log/debugger..."
          }
        ]
      }
    ]
  }
}
