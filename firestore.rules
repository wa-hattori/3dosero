// Firestoreセキュリティルール。正本: .claude/skills/online-multiplayer/SKILL.md の
// 「Firestoreセキュリティルール」節。
//
// 反映は `firebase deploy --only firestore:rules`（Firebase CLIのセットアップ・
// プロジェクトへのログインが必要なユーザー側の手動作業）。
//
// 信頼境界: ここで強制するのは「誰が」「いつ（自分の手番か）」書き込めるかまで。
// 着手が26方向反転ルール上合法かどうかはクライアント側(src/logic/)の検証に委ねる
// （SKILL.mdの「信頼境界」節参照）。

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // 観戦機能を将来追加しやすいよう、読み取りは誰でも許可する。
      allow read: if true;

      // 部屋の作成には3つの形がある(いずれか一方を満たせばよい)。
      // 1. ルームコード制: 作成者が黒番として自分自身を登録し、白番は空席、
      //    ステータスが「待機中」。
      // 2. ランダムマッチング: 待機中の相手を見つけた側が、その場で相手を黒番・
      //    自分を白番として両者を埋めた「進行中」の部屋を直接作る
      //    （`src/net/matchmaking.js`の`tryClaimCandidate`参照）。ルームコード制の
      //    形と前提が異なる(白番が空席ではなく、ステータスも進行中)ため、
      //    同じ条件式では両立できず別ケースとして扱う必要がある。
      // 3. ランダムマッチングのCPU代替対戦（[ranked-matchmaking](../../.claude/skills/ranked-matchmaking/SKILL.md)の
      //    「CPU代替対戦」参照）: 実際の対局はローカルで完結するため、対局が
      //    終わった時点で「既に終了した状態のレート戦の部屋」を自分で直接作り、
      //    レート戦の精算に使う（`settleRankedCpuMatch`参照）。白番は実在しない
      //    (常に空席)。Eloの計算開始点(`ratingSnapshot.black`)が自分の現在の
      //    スコアと一致することをここで検証し、有利な開始点を偽って報告する
      //    ことを防ぐ(1回の精算あたりの変動幅は`isReferencingUnsettledRankedWin`
      //    側で別途±32に絞られる。詳細・既知の限界はSKILL.md参照)。
      allow create: if request.auth != null
        && (
          (request.resource.data.players.black == request.auth.uid
            && request.resource.data.players.white == null
            && request.resource.data.status == 'waiting')
          || (request.resource.data.players.white == request.auth.uid
            && request.resource.data.players.black != null
            && request.resource.data.status == 'in_progress')
          || (request.resource.data.players.black == request.auth.uid
            && request.resource.data.players.white == null
            && request.resource.data.status == 'finished'
            && request.resource.data.ranked == true
            && request.resource.data.settled.black == false
            && request.resource.data.settled.white == true
            && request.resource.data.ratingSnapshot.black
              == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.score)
        );

      // 更新は「参加（白番の空席を自分で埋める）」「既存参加者が自分の手番で着手する」
      // 「既存参加者が対局を放棄する（相手の手番中でも可）」「レート戦の結果を自分の分
      // だけ精算済みにする」「一手タイマー/持ち時間の時間切れを報告する」のいずれかで
      // ある場合のみ許可する。
      // 【注意】これらのケースは前提条件が互いに異なる(参加は「まだ参加者でない」人が
      // 行う操作、着手は「既に参加者かつ自分の手番」の人が行う操作、放棄は「既に参加者
      // だが手番は問わない」人が行う操作)ので、共通の前提条件として先にANDで課しては
      // いけない(それをすると一部のケースが常に拒否される。実機の統合テストで発見した
      // 不具合)。ケースごとに個別の条件式にする。
      allow update: if request.auth != null
        && (isJoining(resource.data, request.resource.data)
          || (isMyTurn(resource.data) && isValidTimeBankUpdate(resource.data, request.resource.data))
          || isForfeiting(resource.data, request.resource.data)
          || isSettling(resource.data, request.resource.data)
          || isTimingOut(resource.data, request.resource.data)
          || isStartingClock(resource.data, request.resource.data));

      function isJoining(before, after) {
        return before.players.white == null && after.players.white == request.auth.uid;
      }

      function isMyTurn(room) {
        // currentTurnはsrc/logic/board.jsのBLACK(1)/WHITE(2)をそのまま保存している
        // (ルール言語からはJSの定数をimportできないため、ここでは数値リテラルで比較する)。
        return (room.currentTurn == 1 && room.players.black == request.auth.uid)
          || (room.currentTurn == 2 && room.players.white == request.auth.uid);
      }

      // 一手タイマー・持ち時間（[online-match-timer](../../.claude/skills/online-match-timer/SKILL.md)参照）。
      // 自分の色のtimeBankだけが、1手あたりの変動幅（±MOVE_TIME_LIMIT_MS）の範囲内で
      // 変化していることを検証する。30000はsrc/net/game-timer.jsのMOVE_TIME_LIMIT_MSを
      // そのまま数値リテラルにしたもの(ルール言語からはJSの定数をimportできない事情は
      // 他の箇所と同じ)。1回の書き込みあたりの変動幅を絞るだけの軽量な不正防止であり、
      // 「毎回elapsedMs:0を偽り続けて持ち時間を際限なく水増しする」ような継続的な不正
      // までは防げない（既知の限界。ranked-matchmakingのMAX_SCORE_DELTAと同じ思想）。
      function isValidTimeBankUpdate(before, after) {
        let moverKey = before.currentTurn == 1 ? 'black' : 'white';
        let opponentKey = moverKey == 'black' ? 'white' : 'black';
        return after.timeBank[opponentKey] == before.timeBank[opponentKey]
          && after.timeBank[moverKey] >= 0
          && after.timeBank[moverKey] <= before.timeBank[moverKey] + 30000;
      }

      // 一手タイマー・持ち時間の時間切れによる無条件敗北の報告。両クライアントが
      // それぞれローカルで検知するため、報告者は参加者のどちらでもよい（自分自身の
      // タイムアウトを自分で報告する場合も、相手のタイムアウトに気づいて報告する
      // 場合もある）。勝者は「タイムアウトが起きた時点で手番だった側の逆の色」で
      // なければならない（報告者が自分を勝者にするような改ざんはできない）。
      function isTimingOut(before, after) {
        let requesterIsParticipant = before.players.black == request.auth.uid
          || before.players.white == request.auth.uid;
        let expectedWinner = before.currentTurn == 1 ? 2 : 1;
        return requesterIsParticipant
          && before.status == 'in_progress'
          && after.status == 'finished'
          && after.winner == expectedWinner;
      }

      // ランダムマッチング成立時はまだ`turnStartedAt`をセットせず(対戦カード画面
      // 〈vs-screen〉を見ている間は一手タイマーを消費させないため)、対局画面に
      // 実際に入る瞬間に改めてセットする。`before.turnStartedAt == null`のときのみ
      // 許可する一方向の遷移にすることで、途中の手番でタイマーをリセットし続ける
      // 不正（無限に自分の手番を引き延ばす）を防ぐ。参加者のどちらが呼んでも
      // よい（対戦カード画面の終了は両クライアントでほぼ同時に起きるため）。
      function isStartingClock(before, after) {
        let requesterIsParticipant = before.players.black == request.auth.uid
          || before.players.white == request.auth.uid;
        return requesterIsParticipant
          && before.status == 'in_progress'
          && before.turnStartedAt == null
          && after.turnStartedAt != null;
      }

      // 「タイトルに戻る」等で対局を放棄する場合。相手の手番中でも離脱できる必要が
      // あるため、isMyTurnとは独立したケースにする。放棄した本人が"自分を勝者にする"
      // ような改ざんができないよう、勝者は必ず自分と逆の色になっていることを検証する。
      function isForfeiting(before, after) {
        let amBlack = before.players.black == request.auth.uid;
        let amWhite = before.players.white == request.auth.uid;
        return before.status == 'in_progress'
          && after.status == 'finished'
          && ((amBlack && after.winner == 2) || (amWhite && after.winner == 1));
      }

      // レート戦（ランダムマッチング）の対局結果を自分の分だけ精算済みにする
      // （[ranked-matchmaking](../../.claude/skills/ranked-matchmaking/SKILL.md)の
      // 「不正防止の方針」参照）。対局が終了済み・レート戦であること、自分がまだ
      // 精算していないことを確認した上で、自分の色の`settled`だけをtrueにする
      // 一方向の遷移のみ許可する。
      function isSettling(before, after) {
        return before.status == 'finished'
          && before.ranked == true
          && (
            (before.players.black == request.auth.uid
              && before.settled.black == false && after.settled.black == true)
            || (before.players.white == request.auth.uid
              && before.settled.white == false && after.settled.white == true)
          );
      }
    }

    match /players/{playerId} {
      // ランキング表示のため、誰でも読める。
      allow read: if true;

      // 新規作成は本人のuidでのみ、名前は1〜20文字、スコア・対局数は初期値のみ許可する。
      // 1500/20はsrc/net/rating.jsのDEFAULT_SCORE/MAX_NAME_LENGTHをそのまま数値
      // リテラルにしたもの(ルール言語からはJSの定数をimportできないため。
      // currentTurnのBLACK(1)/WHITE(2)と同じ事情)。定数を変更したらここも合わせる。
      allow create: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score == 1500
        && request.resource.data.gamesPlayed == 0;

      // 名前の変更（スコア・対局数は変えない）。
      allow update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score == resource.data.score
        && request.resource.data.gamesPlayed == resource.data.gamesPlayed;

      // レート戦（ランダムマッチング）の結果によるスコア更新（名前は変えない）。
      // 32はsrc/net/rating.jsのMAX_SCORE_DELTA(=K_FACTOR)をそのまま数値リテラルに
      // したもの(ルール言語からはJSの定数をimportできない事情は他の箇所と同じ)。
      // `lastSettledRoomId`で参照した部屋が実在し、終了済みのレート戦で、
      // 自分がまだこの部屋の結果を精算していないことをget()で確認する
      // （[ranked-matchmaking](../../.claude/skills/ranked-matchmaking/SKILL.md)の
      // 「不正防止の方針」参照。既知の限界も同節に記載）。
      allow update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.name == resource.data.name
        && request.resource.data.gamesPlayed == resource.data.gamesPlayed + 1
        && request.resource.data.score >= resource.data.score - 32
        && request.resource.data.score <= resource.data.score + 32
        && isReferencingUnsettledRankedWin(request.resource.data.lastSettledRoomId);

      function isReferencingUnsettledRankedWin(roomId) {
        let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
        return room.status == 'finished'
          && room.ranked == true
          && (
            (room.players.black == request.auth.uid && room.settled.black == false)
            || (room.players.white == request.auth.uid && room.settled.white == false)
          );
      }
    }

    match /matchmakingQueue/{ticketId} {
      allow read: if request.auth != null;

      // チケットの作成は本人のuidでのみ、初期ステータスは「待機中」でのみ許可する。
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'waiting';

      // マッチ成立の更新（'waiting' -> 'matched'、roomIdを埋める）は、
      // 他プレイヤーがこのチケットを見つけて成立させる可能性があるため
      // uid本人以外からの更新も許可するが、一方向の遷移のみに限定し、
      // uid/boardSizeなど他のフィールドの改ざんは拒否する。
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.boardSize == resource.data.boardSize;

      // `cancelRandomMatch`（マッチ成立前に自分のチケットを取り消す）に必要。
      // 削除できるのはチケットの作成者本人のみ。
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
